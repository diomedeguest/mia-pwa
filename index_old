<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <title>Diomede Luxury</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&family=Open+Sans:wght@400;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,200,0,0&display=swap" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; }
        body { 
            font-family: 'PT Serif', Georgia, serif; 
            margin: 0; 
            padding: 20px; 
            text-align: center; 
            background-color: #ffffff; 
            color: #000000;
        }
        
        .logo-box { margin-bottom: 20px; min-height: 80px; }
        .logo-img { max-width: 180px; height: auto; }
        
        .divider { width: 40px; height: 1px; background-color: #000000; margin: 15px auto; }
        
        /* TITOLO: Capitalize (Prima lettera di ogni parola maiuscola) */
        h2 { 
            font-family: 'PT Serif', serif;
            font-weight: 400;
            color: #000000; 
            font-size: 35px; 
            letter-spacing: 1px; 
            margin-bottom: 35px; 
            margin-top: 10px;
            text-transform: capitalize;
        }
        
        .grid { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr); 
            gap: 25px 10px; 
            max-width: 400px; 
            margin: 0 auto; 
        }
        
        .btn { 
            text-decoration: none; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
        }
        
        .circle { 
            width: 70px; 
            height: 70px; 
            background-color: #F8F8F8; 
            border-radius: 50%; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            margin-bottom: 8px; 
            color: #000000; 
            border: 1px solid #E0E0E0; 
        }

        .material-symbols-outlined { 
            font-size: 28px; 
            font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 48;
        }
        
        /* PULSANTI: Tutto Maiuscolo */
        span.label { 
            font-family: 'Open Sans', sans-serif; 
            font-size: 10px; 
            color: #000000; 
            text-transform: uppercase; 
            font-weight: 600; 
            letter-spacing: 0.8px;
        }
    </style>
</head>
<body>

    <div class="logo-box">
        <img src="logo.png" alt="Logo" class="logo-img">
    </div>

    <div class="divider"></div>
    <h2>accesso rapido</h2>

    <div class="grid">
		<a href="assets/dettagli.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">home</span></div>
    <span class="label">dettagli</span>
</a>
		<a href="assets/contatti.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">call</span></div>
    <span class="label">contatti</span>
</a>
		<a href="assets/regole.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">gavel</span></div>
    <span class="label">regole</span>
</a>
		<a href="assets/istruzioni.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">menu_book</span></div>
    <span class="label">istruzioni</span>
</a>
        <a href="assets/wifi.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">wifi</span></div>
    <span class="label">wi-fi</span>
</a>
        <a href="assets/trasporti.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">directions_bus</span></div>
    <span class="label">trasporti</span>
</a>

		<a href="assets/turismo.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">explore</span></div>
    <span class="label">Cosa vedere</span>
</a>
        <a href="assets/convenzioni.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">sell</span></div>
    <span class="label">Convenzioni</span>
</a>
		<a href="assets/checkout.html" class="btn">
    <div class="circle"><span class="material-symbols-outlined">logout</span></div>
    <span class="label">Check-Out</span>
</a>
	
	
	</div>

</body>
</html>